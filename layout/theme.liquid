    {% render 'css-variables' %}
    {% style %}
          *,
          *::before,
          *::after {
            box-sizing: inherit;
          }

          html {
            box-sizing: border-box;
            background-color: var(--body-color);
            height: 100%;
            margin: 0;
          }

          body {
            background-color: var(--body-color);
            min-height: 100%;
            margin: 0;
            display: grid;
            grid-template-rows: auto auto 1fr auto;
            grid-template-columns: 100%;
            overflow-x: hidden;
          }

          .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            border: 0;
          }

          .sr-only-focusable:active, .sr-only-focusable:focus {
            position: static;
            width: auto;
            height: auto;
            margin: 0;
            overflow: visible;
            clip: auto;
          }

          @font-face {
          font-family: 'HeyWow medium';
          src: url('https://cdn.shopify.com/s/files/1/0644/6317/5871/files/HeyWow-Regular.eot?v=1729246186.eot');
          src: url('https://cdn.shopify.com/s/files/1/0644/6317/5871/files/HeyWow-Regular.eot?v=1729246186.eot?#iefix') format('embedded-opentype'),
              url('https://cdn.shopify.com/s/files/1/0644/6317/5871/files/HeyWow-Regular.woff2?v=1729246186.woff2') format('woff2'),
              url('https://cdn.shopify.com/s/files/1/0644/6317/5871/files/HeyWow-Regular.woff?v=1729246185.woff') format('woff'),
              url('https://cdn.shopify.com/s/files/1/0644/6317/5871/files/HeyWow-Regular.ttf?v=1729246185.ttf') format('truetype'),
              url('HeyWow-Regular.svg.svg#HeyWow-Regular') format('svg');
          font-weight: normal;
          font-style: normal;
          font-display: swap;
      }
    {% endstyle %}

