{% assign grid_item_id = 'grid-item--' | append: section.id %}
{% render 'button-color-overrides' with
  id: grid_item_id,
  style: settings.quick_shop_button_style,
  text_color: section.settings.button_text_color,
  background_color: section.settings.button_background_color
%}

{{ 'section-featured-collection.min.css' | asset_url | stylesheet_tag }}
<safe-load-scripts class="hidden">
  <script src="{{ 'component-product-card.js' | asset_url }}" type="module" defer="defer" data-flow-load-key="component-product-card"></script>
</safe-load-scripts>

<div class="collectiontabb shop-the-look wrapper-spacing--v wrapper-spacing--h color-scheme--{{ section.settings.colors }}" data-wetheme-section-type="collection--featured-collection" data-wetheme-section-id="{{ section.id }}">
  <div class="width--content">
    <!-- Section title and description -->
    {% render 'dynamic-section-header' with section_title: section.settings.title, section_description: section.settings.description %}

    <!-- Tab Navigation -->
    <div class="collection-tabs">
      <ul class="tab-list">
        {% for block in section.blocks %}
          <li class="tab-item {% if forloop.first %}active{% endif %}" data-tab="tab-{{ forloop.index }}">
            {{ block.settings.collection | split: '/' | last | capitalize }}
          </li>
        {% endfor %}
      </ul>
    </div>

    <div class="tab-content">
      <div class="homepage-indiv-section-wrapper grid--full homepage-featured-content-wrapper">
        {% for block in section.blocks %}
          <div class="tab-pane {% if forloop.first %}active{% endif %}" id="tab-{{ forloop.index }}">
            {% assign collection = collections[block.settings.collection] %}
            {% assign grid_item_width = '' %}
            
            {% case block.settings.grid_desktop %}
              {% when 2 %} {% assign grid_item_width = 'large--one-half' %}
              {% when 3 %} {% assign grid_item_width = 'large--one-third' %}
              {% when 4 %} {% assign grid_item_width = 'large--one-quarter' %}
              {% when 5 %} {% assign grid_item_width = 'large--one-fifth' %}
              {% when 6 %} {% assign grid_item_width = 'large--one-sixth' %}
            {% endcase %}
            
            {% case block.settings.grid_mobile %}
              {% when "1" %} {% assign mobile_item_width = 'small--one-whole' %}
              {% when "2" %} {% assign mobile_item_width = 'small--one-half' %}
            {% endcase %}
            
            <div class="flex-box">
          
             
              <div class="tab-slider ">
                {% if section.settings.override_button_colors %}
                  {% render 'button-color-overrides' with
                    id: navigation_id,
                    style: 'filled',
                    text_color: section.settings.button_text_color,
                    background_color: section.settings.button_background_color
                  %}
                {% endif %}
                {% for product in collection.products limit: block.settings.products_to_show %}
                  <div class="grid__item {{ grid_item_width }} {{ mobile_item_width }} featured-product--grid-item">
                    {% render 'grid-view-item', product: product, collection: collection, section_id: section.id %}
                  </div>
                {% endfor %}
              </div>


<!-- SHOP BY CATEGORY Arrow Button ---  new-collection.liquid cache22   -->
              
           <div class="swiper-btn--wrapper swiper-btn-layout__{{ settings.hover_navigation_desktop }}">
            <div class=" slider-prevss swiper-button--prev btn dynamic-section-button--{{ navigation_id }}">
              {% render 'theme-icon', icon: 'arrow_left' %}
            </div>
            <div class="slider-nextss swiper-button--next btn dynamic-section-button--{{ navigation_id }}">
              {% render 'theme-icon', icon: 'arrow_right' %}
            </div>
          </div>

<!-- **************************   -->

              
            </div>
            
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>


<script>
document.addEventListener("DOMContentLoaded", function() {
    // Get all tab items and tab panes
    const tabItems = document.querySelectorAll('.tab-item');
    const tabPanes = document.querySelectorAll('.tab-pane');

    // Function to initialize the Slick slider
    const initializeSlider = (pane) => {
        $(pane).find('.tab-slider').slick({
            dots: false,
            infinite: false,
            speed: 300,
            slidesToShow: 4, // Show 4 slides on desktop
            slidesToScroll: 1,
            arrows: true,
            prevArrow: $(pane).find('.slider-prevss'),
            nextArrow: $(pane).find('.slider-nextss'),
            responsive: [
                {
                    breakpoint: 768, // Change to mobile view at 768px
                    settings: {
                        slidesToShow: 1.5, // Show 1 slide on mobile
                        slidesToScroll: 1
                    }
                }
            ]
        });
    };

    // Function to handle tab switching
    const switchTab = (index) => {
        // Remove active class from all tab items
        tabItems.forEach(item => item.classList.remove('active'));
        // Hide all tab panes
        tabPanes.forEach(pane => pane.classList.remove('active'));

        // Add active class to the selected tab item and show corresponding tab pane
        tabItems[index].classList.add('active');
        tabPanes[index].classList.add('active');

        // Reinitialize Slick slider for the active tab pane
        $(tabPanes[index]).find('.tab-slider').slick('setPosition');
    };

    // Attach click event to each tab item
    tabItems.forEach((item, index) => {
        item.addEventListener('click', () => {
            switchTab(index);
        });
    });

    // Initialize Slick sliders for each tab pane
    tabPanes.forEach(pane => {
        initializeSlider(pane);
    });
});

</script>



