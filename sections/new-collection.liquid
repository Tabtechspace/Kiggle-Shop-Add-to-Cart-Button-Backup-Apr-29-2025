{% schema %}
{
  "name": "New Collection",
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection",
      "settings": [
        {
          "id": "main-image",
          "type": "image_picker",
          "label": "Main Image"
        },
        {
          "id": "collection",
          "type": "collection",
          "label": "t:all.Collection"
        },
       
        {
          "id": "grid_mobile",
          "type": "radio",
          "label": "t:all.Product_per_row_mobile",
          "options": [
            {
              "value": "1",
              "label": "t:all.1"
            },
            {
              "value": "2",
              "label": "t:all.2"
            }
          ],
          "default": "2"
        },
        {
          "type": "checkbox",
          "id": "override_button_colors",
          "label": "Color",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Collection",
      "category": "Collection"
    }
  ]
}
{% endschema %}
