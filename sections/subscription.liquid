<!-- Include intl-tel-input CSS -->
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css"
/>

<!-- Include intl-tel-input JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>

<section class="wrapper-spacing--h width--content subscription-container">
  <div class="width--content subscription-wrapper" style="background-color: {{ section.settings.background_color }};">
    <div class="subscription-row">
      {% form 'customer', id: form_id, class: 'subscription-form' %}
        <div class="form-block">
          <div class="subscription-col">
            <h2>{{ section.settings.mailing_title }}</h2>
            <p>{{ section.settings.mailing_description }}</p>
          </div>

          <div class="input-field">
            <div class="subscription-form">
              <div class="input-flex-box">
                <!-- Email Input -->
                <div class="input-block">
                  <span class="mandatory">Email*</span>
                  <div class="input-container">
                    <input 
                      type="email" 
                      name="contact[email]" 
                      placeholder="abc@gmail.com" 
                      autocomplete="on" 
                      required 
                      id="email-input"
                      title="Please enter a valid email address"
                    />
                    <div id="email-error" style="color: red; display: none; font-size: 12px;"></div>
                    
<div class="policy-link desk-policy">
{{ section.settings.privacy_text }}
</div>
                  </div>
                </div>

                <!-- Phone Input -->
                <div class="input-block">
                  <span class="mandatory">Phone Number (Optional)</span>
                  <div class="input-container">
                    <input 
                      type="tel" 
                      id="phone-input" 
                      name="contact[note]" 
                      placeholder="Enter phone number" 
                      autocomplete="on" 
                      title="Please enter a valid phone number"
                    />
                    <div id="phone-error" style="color: red; display: none; font-size: 12px;"></div>
                    <div class="policy-link mobile-policy">
{{ section.settings.privacy_text }}
</div>
                  </div>
                </div>

                <!-- Submit Button -->
                <div class="input-btn">
                  <button type="submit" id="submit-button" disabled class="disabled">
                    {{ section.settings.text_button_text }}
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endform %}
    </div>
  </div>
</section>
<!-- Popup Message -->
<div id="popup-message" class="popup hidden">
  <div class="popup-content">
    <p>Thank you for subscribing!</p>
    <button id="close-popup"><i class="fa-solid fa-circle-check"></i></button>
  </div>
</div>


<script>
  // Restrict input to numeric values only for the phone input field
document.getElementById('phone-input').addEventListener('keypress', function (e) {
  const charCode = e.charCode ? e.charCode : e.keyCode;
  
  // Allow only numbers (ASCII codes 48-57) and control keys like backspace
  if (charCode < 48 || charCode > 57) {
    e.preventDefault();
  }
});

// Limit phone input length to 10 digits
document.getElementById('phone-input').addEventListener('input', function (e) {
  const maxLength = 10; // Set maximum length
  if (this.value.length > maxLength) {
    this.value = this.value.slice(0, maxLength); // Truncate excess digits
  }
});

// Phone number validation and submit button control
document.getElementById('phone-input').addEventListener('input', function () {
  const phoneInput = document.getElementById('phone-input');
  const phoneError = document.getElementById('phone-error');
  const submitButton = document.getElementById('submit-button');
  
  const phoneRegex = /^\d{10}$/; // Regex for valid 10-digit phone number

  // Clear the error message initially
  phoneError.style.display = 'none';
  phoneError.textContent = '';

  // Check if the phone number is valid (10 digits)
  if (phoneRegex.test(phoneInput.value)) {
    submitButton.disabled = false;
    submitButton.classList.remove('disabled');
  } else if (phoneInput.value !== '') {
    // Show error message if invalid
    phoneError.style.display = 'block';
    phoneError.textContent = 'Please enter a valid 10-digit phone number';
    submitButton.disabled = true;
    submitButton.classList.add('disabled');
  }
});

// Initialize intl-tel-input with country code and validation
const phoneInputField = document.querySelector("#phone-input");
const phoneInput = window.intlTelInput(phoneInputField, {
  initialCountry: "in", // Set initial country
  separateDialCode: true,
  utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
});

// Phone number validation with intl-tel-input
phoneInputField.addEventListener('input', function () {
  const phoneError = document.getElementById('phone-error');
  const submitButton = document.getElementById('submit-button');
  
  if (phoneInput.isValidNumber()) {
    phoneError.style.display = 'none'; // Hide error
    submitButton.disabled = false;    // Enable submit button
    submitButton.classList.remove('disabled');
  } else {
    phoneError.style.display = 'block'; // Show error
    phoneError.textContent = "Please enter a valid phone number.";
    submitButton.disabled = true;     // Disable submit button
    submitButton.classList.add('disabled');
  }
});

// Append the full phone number (including country code) before form submission
document.querySelector('.subscription-form').addEventListener('submit', function (e) {
  if (!phoneInput.isValidNumber()) {
    e.preventDefault();
    document.getElementById('phone-error').textContent = "Please enter a valid phone number.";
    return;
  }
  const fullPhoneNumber = phoneInput.getNumber(); // Get full phone number
  phoneInputField.value = fullPhoneNumber;        // Update the input value with the full number
});

// Email input validation
document.getElementById('email-input').addEventListener('input', function () {
  const emailInput = this;
  const emailError = document.getElementById('email-error');
  const submitButton = document.getElementById('submit-button');
  const emailRegex = /^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.(com|shop|in|co)$/;

  if (emailRegex.test(emailInput.value)) {
    emailError.style.display = 'none'; // Hide error
    submitButton.disabled = false;    // Enable submit button
    submitButton.classList.remove('disabled');
  } else {
    emailError.style.display = 'block'; // Show error
    emailError.textContent = "Please enter a valid email address.";
    submitButton.disabled = true;     // Disable submit button
    submitButton.classList.add('disabled');
  }
});

</script>


<style>
  /* Styling for the disabled submit button */
  .disabled {
    background-color: #ccc;  /* Gray background when disabled */
    cursor: not-allowed;     /* Change cursor to indicate it is not clickable */
  }

  /* Styling for error message */
  #email-error {
    color: red;
    font-size: 12px;
        transition: all .3s ease-in-out;
    margin-top: 5px;
  }
  input#note-input {
    padding: .75rem 3rem;
}
  .iti {

    width: 100%;
}
</style>


<style>
button.disabled {
    opacity: 0.8;
    cursor: not-allowed !important;
}
    #email-input:-webkit-autofill {
    background-color: transparent !important;
    -webkit-box-shadow: 0 0 0px 1000px transparent inset !important;
    -webkit-text-fill-color: black !important;
  }
</style>
<script>
  const noteInput = document.getElementById('note-input');
  
  noteInput.addEventListener('input', () => {
    // Limit to 10 digits
    if (noteInput.value.length > 10) {
      noteInput.value = noteInput.value.slice(0, 10);
    }
  });
</script>
