          flex-direction: column-reverse;
      }
      back-to-top.back-to-top--visible img {
          max-width: 42px !important;
      }
    </style>
    <script>
      document.querySelector('button[name="add-to-cart"]').addEventListener('click', function(event) {
        // Get the quantity from the input field directly
        const quantity = parseInt(document.querySelector('quantity-input input').value) || 1;

        // Store the updated quantity in localStorage to persist across page refreshes
        localStorage.setItem('savedQuantity', quantity);

        // Call the addToCart function with the correct quantity
        addToCart(quantity);
      });

      function addToCart(quantity) {
        // Ensure the quantity is correctly passed to the cart
        const variantId = getVariantId(); // Replace this with the correct method to get the variant ID

        // Add item to the cart via Shopify's AJAX API or your method
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: quantity,
          }),
        })
        .then((response) => response.json())
        .then((data) => {
          console.log('Item added to cart', data);
          // Optionally, update the cart UI or trigger an event
        })
        .catch((error) => {
          console.error('Error adding to cart:', error);
        });
      }
    </script>

